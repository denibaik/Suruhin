# PostgreSQL connection string dari DigitalOcean Managed Database.
DATABASE_URL=postgresql://user:password@host:25060/database?sslmode=require

# Gunakan disable hanya untuk Postgres lokal tanpa TLS.
PGSSL=require
PG_POOL_MAX=10

# Kredensial admin CMS/analytics. Jangan gunakan nilai contoh di production.
ADMIN_EMAIL=admin@suruhin.id
ADMIN_PASSWORD=replace-with-a-strong-password

# Secret untuk signed HttpOnly session cookie, minimal 32 karakter.
SESSION_SECRET=replace-with-at-least-32-random-characters
